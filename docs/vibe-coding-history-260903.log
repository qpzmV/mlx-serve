       pinned: []bool                                                                                                                                      
       hand: u32                                                                                                                                           
       hits: u64, misses: u64                                                                                                                              
                                                                                                                                                           
       pub fn init(allocator, io, s, config, model_dir, n_slots) !*SlotPool                                                                                
       pub fn deinit                                                                                                                                       
       /// maps `experts` (expert ids, all from `layer`) to pool slots + fills misses                                                                      
       pub fn ensure(self, s, layer: u16, experts: []const u32, out: []u32) !void                                                                          
