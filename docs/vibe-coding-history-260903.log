 ### 2. src/expert_store.zig — rewrite                                                                                                                     
                                                                                                                                                           
 ```zig                                                                                                                                                    
   //! Expert streaming for qwen4_exp (port of slotstream's ExpertStore + SlotPool).                                                                       
   //!                                                                                                                                                     
   //! The qwen4_exp checkpoint stacks the 512 routed experts of each of its 48 MoE                                                                        
   //! layers into 9 packed safetensors tensors (gate/up/down × weight|scales|                                                                             
   //! biases). Materialising the whole 75.5 GB bank into MLX memory does not fit                                                                          
   //! a 128 GB machine, so under --expert-stream the banks are NOT bound at                                                                               
   //! load; a global slot pool (one set of 9 pool arrays, shared by every MoE                                                                             
   //! layer INCLUDING the MTP draft layer's own bank, which stays resident) holds                                                                         
   //! `n_slots` expert records in the checkpoint's packed layout. moeMLP2 remaps                                                                          
   //! each forward's selected expert ids to pool slot ids BEFORE argsort (the                                                                             
   //! sorted path assumes monotonic rhs_indices — quantized.cpp's gather_qmm_rhs                                                                          
   //! fast path) and hands the pool arrays to the same gather_qmm/gatherQmv/take                                                                          
   //! kernels.                                                                                                                                            
   //!                                                                                                                                                     
   //! Thread-safety: the pool is touched by the single inference thread only                                                                              
   //! (scheduler's invariant); if a second mlx caller ever appears, the pool's                                                                            
   //! map/CLOCK state needs a lock.                                                                                                                       
                                                                                                                                                           
   const std = @import("std");                                                                                                                             
   const mlx = @import("mlx.zig");                                                                                                                         
   const log = @import("log.zig");                                                                                                                         
                                                                                                                                                           
   pub const N_PIECES = 9;                                                                                                                                 
   pub const piece_names = [9][]const u8{ "gate_proj.weight", "gate_proj.scales", "gate_proj.biases", "up_proj.weight", "up_proj.scales",                  
 "up_proj.biases", "down_proj.weight", "down_proj.scales", "down_proj.biases" };                                                                           
   // piece role: 0=w(gate) 1=s 2=b | 3=w(up) 4=s 5=b | 6=w(down) 7=s 8=b                                                                                  
                                                                                                                                                           
   pub const ExpertKey = struct {                                                                                                                          
       layer: u16,                                                                                                                                         
       expert: u32,                                                                                                                                        
       // eql + hash (mixer)                                                                                                                               
   };                                                                                                                                                      
                                                                                                                                                           
   pub const TensorRef = struct {                                                                                                                          
       file: u32 = std.math.maxInt(u32), // index into Shard                                                                                               
       dtype: mlx.mlx_dtype = .bfloat16,                                                                                                                   
       shape: [3]i64 = .{ 0, 0, 0 },                                                                                                                       
       offset: u64 = 0, // start of the stacked bank (absolute value, after the 8+header_len shift)                                                        
       fn rowBytes(ref) u32 { shape[1]*shape[2]*itemSize }                                                                                                 
   };                                                                                                                                                      
                                                                                                                                                           
   pub const Shard = struct { path: [:0]u8, fd: std.c.fd_t };                                                                                              
                                                                                                                                                           
   pub const ExpertStore = struct {                                                                                                                        
       allocator                                                                                                                                           
       num_layers: u32                                                                                                                                     
       num_experts: u32                                                                                                                                    
       record_bytes: u32                                                                                                                                   
       shards: []Shard                                                                                                                                     
       refs: []TensorRef // [num_layers*9]                                                                                                                 
   };                                                                                                                                                      
                                                                                                                                                           
   init(io, allocator, model_dir, weight_prefix):                                                                                                          
     - open dir; read model.safetensors.index.json; parse weight_map                                                                                       
     - for each l in 0..num_layers, for each piece p: name = "{prefix}.layers.{l}.mlp.switch_mlp.{piece}"; look up in weight_map → shard file; open that   
 file's fd (F_NOCACHE on macOS); read header; look up tensor's dtype/shape/offset                                                                          
     - if any missing → error (streaming without index = broken pack)                                                                                      
     - record_bytes = sum of 9 row_bytes                                                                                                                   
                                                                                                                                                           
   readBatch(self, allocator, s, layer, keys: []const u32, dst: [9][]u8) !void:                                                                            
     - for each piece p, for each expert e: pread into dst[p][i*row_bytes..] from shard fd                                                                 
     - QD parallel: spawn min(qd, tasks) threads that stride the task list                                                                                 
 ```                                                                                                                                                       
                                                                                                                                                           
